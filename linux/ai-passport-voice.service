[Unit]
Description=AI Passport Linux voice forwarder (voxtype offline ASR)
Documentation=https://github.com/manchunx7-bit/folo-ai-passport-voice
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Nothing this process creates may be readable by other local users: the state
# file holds the last transcript. Files that need 0600 set their own mode too.
UMask=0077
# Installed by linux/install.sh: points at the repo checkout. wtype needs
# the Wayland socket, so this binds to the graphical session, not boot.
# -u: journal  collected via pipe, not a TTY. Without it print() block-
# buffers and beacon/discovery lines never appear live in the log.
ExecStart=/usr/bin/python3 -u %h/Apps/folo-ai-passport-voice/linux/voice_forwarder.py

[Install]
WantedBy=graphical-session.target
